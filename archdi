#!/bin/bash


# Arch Linux Desktop Install (archdi)
# -----------------------------------
# author    : MatMoul (original author)
#             https://github.com/MatMoul
# maintainer: sevenzip2 (fork)
#             https://github.com/sevenzip2
# project   : https://github.com/sevenzip2/archdi
# upstream  : https://github.com/MatMoul/archdi
# license   : GPLv3 (http://opensource.org/licenses/GPL-3.0)



apptitle="Arch Linux Desktop Install (archdi) - Version: 2026.10.22.06.18.02 (GPLv3)"
version="2026.10.22.06.18.02"
cachedir=~/.cache/archdi

githubuser=sevenzip2

lastverurl1=https://raw.githubusercontent.com/$githubuser/archdi/master/version
lastverurl2=https://cdn.jsdelivr.net/gh/$githubuser/archdi@master/version

binurl1=https://raw.githubusercontent.com/$githubuser/archdi/master/archdi
binurl2=https://cdn.jsdelivr.net/gh/$githubuser/archdi@master/archdi

# The menus live in the pkg/ folder of this repository
# $1 : github user
# $2 : branch
setpkgurls(){
  # 1 : whole pkg/ folder from the GitHub source archive
  pkgurl1=https://github.com/$1/archdi/archive/refs/heads/$2.tar.gz
  pkgbaseurl1=https://raw.githubusercontent.com/$1/archdi/$2/pkg
  # 2 : lib only from jsDelivr, lib then downloads each menu when needed
  liburl2=https://cdn.jsdelivr.net/gh/$1/archdi@$2/pkg/lib
  pkgbaseurl2=https://cdn.jsdelivr.net/gh/$1/archdi@$2/pkg
}
setpkgurls $githubuser master


help(){
  echo "-h | --help                   : this screen"
  echo "-i | --install                : install"
  echo "-l | --local dir              : run a local pkg dir (archdi/pkg)"
  echo "-b | --branch branch          : launch a branch of $githubuser/archdi"
  echo "-t | --test githubuser branch : launch a forked branch"
  echo "no args                       : start archdi"
}

install(){
  dependencies
  echo "Install $apptitle ..."
  echo ""
  chmod 755 $0 2>/dev/null
  mv $0 /usr/local/bin/archdi 2>/dev/null
  echo ""
  echo "$apptitle is installed."
  echo "type archdi to start."
  if [[ -f "/usr/bin/archdi" ]]; then
    rm /usr/bin/archdi 2>/dev/null
    echo "If archdi doesn't start after update, run 'hash -r'"
  fi
}

run(){
  dependencies
  rm -R $cachedir 2>/dev/null
  mkdir -p $cachedir 2>/dev/null
  cd $cachedir 2>/dev/null
  
  if [ ! "$pkgdir" = "" ]; then
    cp -r "$pkgdir"/. . >/dev/null
  else
    if [ "$pkgurl" == "" ]; then
      if ! curl -fsSL $liburl -o lib; then
        echo "Unable to download $liburl"
        exit 1
      fi
    else
      echo ""
      echo "Downloading packages..."
      if ! curl -fsSL $pkgurl -o archdi.tar.gz || ! tar -xzf archdi.tar.gz --strip-components=2 --wildcards '*/pkg/*'; then
        echo "Unable to download $pkgurl"
        exit 1
      fi
      rm -f archdi.tar.gz
    fi
    sed -i "/^baseurl=/c\baseurl=$pkgbaseurl" lib
  fi
  
  chmod 755 lib 2>/dev/null
  if [ ! "$pkgdir" = "" ]; then
    sed -i "/^apptitle=/c\apptitle=\"Arch Linux Desktop Install (archdi) - local: $pkgdir (GPLv3)\"" lib
    sed -i "/^baseurl=/c\baseurl=$pkgdir" lib
  elif [ ! "$branchoption" = "" ]; then
    sed -i "/^apptitle=/c\apptitle=\"Arch Linux Desktop Install (archdi) - Branch: $githubuser/$branchoption (GPLv3)\"" lib
  fi
  if [ "$chrootoption" = "true" ]; then
    ./lib --chroot
  else
    ./lib --root
  fi
  
  
  cd 2>/dev/null
  rm -R $cachedir 2>/dev/null
}

dependencies(){
  needinstall="false"
  clear
  echo "Checking internet and server connexion ..."
  lastverurl=$lastverurl1
  lastver=$(curl -fsSL $lastverurl)
  if [ "$?" = "0" ] && [ "${#lastver}" = "19" ]; then
    binurl=$binurl1
    liburl=""
    pkgurl=$pkgurl1
    pkgbaseurl=$pkgbaseurl1
  else
    lastverurl=$lastverurl2
    lastver=$(curl -fsSL $lastverurl)
    if [ "$?" = "0" ] && [ "${#lastver}" = "19" ]; then
      binurl=$binurl2
      liburl=$liburl2
      pkgurl=""
      pkgbaseurl=$pkgbaseurl2
    else
      echo "Unable to reach $lastverurl1 or $lastverurl2"
      exit 1
    fi
  fi
  echo ""
  echo "Checking $apptitle dependencies :"
  echo ""
  if [ -e /usr/bin/dialog ]; then
    echo "dialog : installed"
  else
    echo "dialog : not installed"
    needinstall="true"
  fi
  if [ "$needinstall" = "true" ]; then
    echo ""
    echo "Install missing dependencies ?"
    read -p "Install missing dependencies ? (Y/n)" choice
    case "$choice" in 
      n|N ) exit 1;;
    esac
    pacman -S --needed --noconfirm dialog
  fi
  echo ""
  echo "Checking bin version..."
  chkupgrade
}

chkupgrade(){
  if [[ "$0" = "/usr/local/bin/archdi" ]]; then
    if [ ! "$version" = "$lastver" ]; then
      if (dialog --backtitle "$apptitle" --yesno "New version found !\n\nInstall last version ?" 0 0) then
        cd /tmp
        if curl -fsSL $binurl -o archdi; then
          sh archdi -i
          exit 0
        fi
        echo "Unable to download $binurl"
      fi
    fi
  fi
}

branchoption=""
while (( "$#" )); do
  case $1 in
    -h|--help) help
               exit 0;;
    -i|--install) install
                  exit 0;;
    --chroot) chrootoption="true";;
    -b | --branch)
      shift
      setpkgurls $githubuser "$1"
      branchoption="$1"
    ;;
    -l | --local)
      shift
      apptitle="Arch Linux Desktop Install (archdi) - Version: local ($1)"
      pkgdir="$1"
    ;;
    -t | --test)
      shift
      setpkgurls "$1" "$2"
      githubuser="$1"
      branchoption="$2"
      shift
    ;;
  esac
  shift
done

run
