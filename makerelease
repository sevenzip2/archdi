#!/bin/bash

prjname=archdi
version=$(date +"%Y.%m.%d.%H.%M.%S")
branch=$(git rev-parse --abbrev-ref HEAD)


clear
read -p "Current branch is $branch. Continue ? (y/N)" choice
case "$choice" in 
  y|Y ) echo "Begin Build Release...";;
  * )
    echo "cancel build !"
    exit 1
  ;;
esac
echo "Building version $version..."
echo ""

echo "Finalise archdi script and lib..."
sed -i /^apptitle=/c\apptitle=\""Arch Linux Desktop Install (archdi) - Version: $version (GPLv3)"\" archdi pkg/lib
sed -i /^version=/c\version=\""$version"\" archdi
sed -i /^baseurl=/c\baseurl=https://raw.githubusercontent.com/sevenzip2/archdi/master/pkg pkg/lib

echo "Set version..."
echo "$version" >version
chmod 640 version

echo "Make last commit..."
git commit -a -m "New Release : $version"

if [ ! "$branch" = "master" ]; then
  echo "Merge branch $branch to master..."
  git checkout master
  git pull
  git merge $branch

  read -p "Delete branch $branch ? (y/N)" choice
  case "$choice" in 
    y|Y )
      git branch -D $branch
    ;;
  esac
fi

read -p "Push release ? (Y/n)" choice
case "$choice" in 
  n|N )
    exit 1
  ;;
esac

git checkout master
echo "Push release..."
git push

if [ ! "$branch" = "master" ]; then
  git checkout $branch
  git merge master
  git push
fi
