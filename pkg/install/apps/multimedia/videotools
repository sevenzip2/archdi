#!/bin/bash
. ./lib

options=()
options+=("avidemux-qt" "(QT) Video Editor" off)
options+=("simplescreenrecorder-git" "(AUR) (QT) Screen Recorder" off)

sel=$(dialog --backtitle "$apptitle" --title "Videos Tools applications :" --cancel-button "Back" --checklist "Choose what you want" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  case $itm in
    "simplescreenrecorder-git") aurpkg="$aurpkg $(echo $itm | sed 's/"//g')";;
    *) pkg="$pkg $(echo $itm | sed 's/"//g')";;
  esac
done

instpkg "$pkg" "$aurpkg" || exit 1

exit 0
