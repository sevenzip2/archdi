#!/bin/bash
. ./lib

options=()
options+=("pipewire" "Audio and video server" on)
options+=("wireplumber" "Session manager" on)
options+=("pipewire-alsa" "" on)
options+=("pipewire-jack" "" on)
options+=("pipewire-pulse" "" on)
options+=("pipewire-v4l2" "Camera access for old V4L2 apps" off)
options+=("pipewire-zeroconf" "Network audio discovery" off)
options+=("gst-plugin-pipewire" "" on)
if grep -q '^\[multilib\]' /etc/pacman.conf; then
  options+=("lib32-pipewire" "32-bit (Steam, Wine)" on)
fi
# Recent laptops (Intel/AMD) need the Sound Open Firmware for internal audio
if ls /sys/class/power_supply/BAT* &>/dev/null; then
  options+=("sof-firmware" "Laptop audio firmware" on)
else
  options+=("sof-firmware" "Laptop audio firmware" off)
fi
options+=("alsa-utils" "alsamixer" on)
options+=("pavucontrol" "Volume control" off)
options+=("easyeffects" "" off)
options+=("pipewire-x11-bell" "" off)

sel=$(dialog --backtitle "$apptitle" --title "PipeWire Install" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  case $itm in
    *) pkg="$pkg $(echo $itm | sed 's/"//g')";;
  esac
done

# jack2 (pulled earlier by ffmpeg and others) conflicts with pipewire-jack
if [[ " $pkg " == *" pipewire-jack "* ]]&&pacman -Qq jack2 &>/dev/null; then
  if (confirm "jack2 is installed and conflicts with pipewire-jack.\n\nReplace jack2 with pipewire-jack ?") then
    clear
    echo "pacman -Rdd --noconfirm jack2"
    pacman -Rdd --noconfirm jack2
    echo "pacman -S --needed pipewire-jack"
    if ! pacman -S --needed pipewire-jack; then
      # Keep a libjack.so provider for the installed applications
      echo "pacman -S --noconfirm jack2"
      pacman -S --noconfirm jack2
    fi
    pressanykey
  fi
  pkg=$(echo " $pkg " | sed 's/ pipewire-jack / /')
fi

instpkg "$pkg" "$aurpkg" || exit 1

exit 0
