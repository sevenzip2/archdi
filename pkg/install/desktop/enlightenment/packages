#!/bin/bash
. ./lib

options=()

package=""
options+=("enlightenment" "" on)
options+=("connman" "Network manager for the E module (conflicts with NetworkManager)" off)
options+=("acpid" "Legacy ACPI events (systemd-logind handles them)" off)
options+=("terminology" "Terminal" on)

sel=$(dialog --backtitle "$apptitle" --title "Enlightenment Install :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  pkg="$pkg $(echo $itm | sed 's/"//g')"
done

instpkg "$pkg" "$aurpkg" || exit 1

exit 0
