#!/bin/bash
. ./lib

options=()
options+=("Plasma" "KDE Plasma 6 (Wayland)")
options+=("XFCE4" "Lightweight GTK desktop (X11)")
options+=("Gnome" "GNOME (Wayland)")
options+=("Cinnamon" "Traditional GTK desktop")
options+=("COSMIC" "Desktop by System76 (Wayland)")
options+=("Hyprland" "Tiling compositor (Wayland)")
options+=("Sway" "i3-like tiling compositor (Wayland)")
options+=("niri" "Scrollable tiling compositor (Wayland)")
options+=("LXDE" "Very light GTK desktop (X11)")
options+=("LXQt" "Lightweight Qt desktop")
options+=("Mate" "GNOME 2 style desktop (X11)")
options+=("Enlightenment" "EFL desktop")
options+=("Openbox" "Minimal window manager (X11)")
options+=("Deepin" "Deepin desktop")

defaultitem=""
sel=$(dialog --backtitle "$apptitle" --title "Install Desktop Menu :" --default-item "$defaultitem" --cancel-button "Back" --menu "Choose a desktop" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi
sed -i "/^defaultitem=/c\defaultitem=\"$sel\"" $0

case $sel in
  'Plasma') menu install/desktop/plasma/menu;;
  'XFCE4') menu install/desktop/xfce4/menu;;
  'Gnome') menu install/desktop/gnome/menu;;
  'Cinnamon') menu install/desktop/cinnamon/menu;;
  'COSMIC') script install/desktop/cosmic/packages;;
  'Hyprland') script install/desktop/hyprland/packages;;
  'Sway') script install/desktop/sway/packages;;
  'niri') script install/desktop/niri/packages;;
  'LXDE') script install/desktop/lxde/packages;;
  'LXQt') menu install/desktop/lxqt/menu;;
  'Mate') menu install/desktop/mate/menu;;
  'Enlightenment') script install/desktop/enlightenment/packages;;
  'Openbox') script install/desktop/openbox/packages;;
  'Deepin') menu install/desktop/deepin/menu;;
esac

exit 0
