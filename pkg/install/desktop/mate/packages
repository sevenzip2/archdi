#!/bin/bash
. ./lib

options=()

package=""
items=$(pacman -Sqg $package)
for item in $items; do
  options+=("$item" "" on)
done
# The mate group has no terminal, it is in mate-extra
if [ "$package" = "mate" ]; then
  options+=("mate-terminal" "Terminal" on)
  # MATE is X11, the Wayland session runs it in wayfire
  options+=("mate-wayland-session" "(AUR) Wayland session in wayfire (experimental)" off)
fi

sel=$(dialog --backtitle "$apptitle" --title "$package Install :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)

if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  case $itm in
    "mate-wayland-session") aurpkg="$aurpkg $(echo $itm | sed 's/"//g')";;
    *) pkg="$pkg $(echo $itm | sed 's/"//g')";;
  esac
done

instpkg "$pkg" "$aurpkg" || exit 1

exit 0
