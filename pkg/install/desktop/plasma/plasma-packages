#!/bin/bash
. ./lib

options=()

package="plasma"
items=$(pacman -Sqg $package)
for item in $items; do
  # Off by default : special purpose shells and tools, legacy themes, plasma-login-manager would be a second display manager
  case $item in
    "plasma-bigscreen") options+=("$item" "TV shell (10-foot UI)" off);;
    "plasma-login-manager") options+=("$item" "Alternative to sddm" off);;
    "plasma-sdk") options+=("$item" "Plasma development tools" off);;
    "krdp") options+=("$item" "Remote desktop (RDP) server" off);;
    "plasma-keyboard") options+=("$item" "On-screen keyboard (touch)" off);;
    "oxygen" | "oxygen-cursors" | "oxygen-sounds") options+=("$item" "Legacy Oxygen theme" off);;
    "breeze-plymouth" | "plymouth-kcm") options+=("$item" "Boot splash, needs plymouth in mkinitcpio" off);;
    "discover") options+=("$item" "App store (PackageKit), Flatpak menu adds it with flatpak" off);;
    "kup") options+=("$item" "Backup tool" off);;
    *) options+=("$item" "" on);;
  esac
done
# The plasma group has no terminal, file manager or text editor (they are KDE applications)
options+=("konsole" "Terminal" on)
options+=("dolphin" "File manager" on)
options+=("kate" "Text editor" on)
options+=("ark" "Archive manager" on)
options+=("gwenview" "Image viewer" off)
options+=("okular" "Document viewer" off)

sel=$(dialog --backtitle "$apptitle" --title "$package Install :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)

if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  pkg="$pkg $(echo $itm | sed 's/"//g')"
done

instpkg "$pkg" "$aurpkg" || exit 1

for itm in $sel; do
  case $itm in
    "sddm-kcm")
      dmenable sddm
    ;;
  esac
done

exit 0
