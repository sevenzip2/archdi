#!/bin/bash
. ./lib

options=()

# Install the -meta packages themselves (not their groups) so new KDE apps come with updates
items=$(pacman -Sqs meta | grep '^kde.*-meta$')
for item in $items; do
  case $item in
    "kde-graphics-meta" | \
    "kde-multimedia-meta" | \
    "kde-network-meta" | \
    "kde-system-meta" | \
    "kde-utilities-meta") options+=("$item" "" on);;
    "kde-applications-meta") ;;
    "kde-development-environment-meta") ;;
    "kde-sdk-meta") ;;
    *) options+=("$item" "" off);;
  esac
done

sel=$(dialog --backtitle "$apptitle" --title "KDE Apps Meta Packages :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)

if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  pkg="$pkg $(echo $itm | sed 's/"//g')"
done

instpkg "$pkg" "$aurpkg" || exit 1

exit 0
