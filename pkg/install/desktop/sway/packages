#!/bin/bash
. ./lib

options=()
options+=("sway" "Compositor" on)
options+=("xdg-desktop-portal-wlr" "Screen sharing portal" on)
options+=("xorg-xwayland" "X11 apps support" on)
options+=("qt6-wayland" "Qt apps on Wayland" on)
options+=("mate-polkit" "Polkit agent" on)
options+=("foot" "Default terminal (Super+Enter)" on)
options+=("waybar" "Status bar" on)
# The default /etc/sway/config runs wmenu-run on Super+D
options+=("wmenu" "Default app launcher (Super+D)" on)
options+=("fuzzel" "App launcher (set \$menu fuzzel)" off)
options+=("mako" "Notifications" on)
options+=("swaybg" "Wallpaper" on)
options+=("swaylock" "Screen locker" on)
options+=("swayidle" "Idle daemon" on)
options+=("grim" "Screenshot" on)
options+=("slurp" "Region selection for grim" on)
options+=("wl-clipboard" "Clipboard tools" on)
options+=("brightnessctl" "Backlight control" on)
options+=("network-manager-applet" "Network tray applet" on)
options+=("pavucontrol" "Volume control" on)
options+=("xdg-desktop-portal-gtk" "File chooser portal" on)
options+=("nwg-look" "GTK theme settings" off)
options+=("qt6ct" "Qt6 theme settings" off)

sel=$(dialog --backtitle "$apptitle" --title "Sway Install :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  pkg="$pkg $(echo $itm | sed 's/"//g')"
done

instpkg "$pkg" "$aurpkg" || exit 1

clear
# The default config starts swaybar and no polkit agent or tray applet, /etc/sway/config includes config.d
conf=/etc/sway/config.d/60-archdi.conf
mkdir -p /etc/sway/config.d
echo "# Programs installed by archdi" > $conf
if [ -f /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 ]; then
  # Password prompts of GUI apps
  echo "exec /usr/lib/mate-polkit/polkit-mate-authentication-agent-1" >> $conf
fi
if [ -f /usr/bin/waybar ]; then
  # bar-0 is the bar of /etc/sway/config
  echo "bar bar-0 swaybar_command waybar" >> $conf
fi
if [ -f /usr/bin/nm-applet ]; then
  # waybar shows StatusNotifierItem icons only
  echo "exec nm-applet --indicator" >> $conf
fi
echo "$conf :"
cat $conf
echo ""
echo "Start it from a display manager (ly, greetd, sddm...) or from a TTY with :"
echo "  sway"
echo "Copy /etc/sway/config to ~/.config/sway/config to customize it."
pressanykey

exit 0
