#!/bin/bash
. ./lib

options=()
options+=("sddm" "Display manager" on)
options+=("oxygen-icons" "Alternative icon theme (breeze is the default)" off)
options+=("connman" "Network manager (conflicts with NetworkManager)" off)
options+=("obconf-qt" "" on)


sel=$(dialog --backtitle "$apptitle" --title "LXQt Complements :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  case $itm in
    *) pkg="$pkg $(echo $itm | sed 's/"//g')";;
  esac
done

instpkg "$pkg" "$aurpkg" || exit 1

for itm in $sel; do
  case $itm in
    "sddm") dmenable sddm;;
  esac
done

exit 0
