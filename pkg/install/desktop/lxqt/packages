#!/bin/bash
. ./lib

options=()

# The lxqt group, not a search : the search misses qterminal and openbox and adds build tools
items=$(pacman -Sqg lxqt)
for item in $items; do
  options+=("$item" "" on)
done
options+=("lxqt-wayland-session" "Wayland session (needs a compositor : labwc, kwin...)" off)

sel=$(dialog --backtitle "$apptitle" --title "LXQT Install :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)

if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  pkg="$pkg $(echo $itm | sed 's/"//g')"
done

instpkg "$pkg" "$aurpkg" || exit 1

exit 0
