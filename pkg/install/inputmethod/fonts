#!/bin/bash
. ./lib

options=()
options+=("noto-fonts-cjk" "Noto Sans/Serif CJK (recommended)" on)
options+=("adobe-source-han-sans-kr-fonts" "Source Han Sans KR" off)
options+=("adobe-source-han-serif-kr-fonts" "Source Han Serif KR" off)
options+=("ttf-baekmuk" "Baekmuk" off)
options+=("ttf-nanum" "(AUR) Nanum" off)
options+=("ttf-d2coding" "(AUR) D2Coding, coding font" off)

sel=$(dialog --backtitle "$apptitle" --title "Korean Fonts :" --cancel-button "Back" --checklist "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi

for itm in $sel; do
  case $itm in
    "ttf-nanum" | \
    "ttf-d2coding") aurpkg="$aurpkg $(echo $itm | sed 's/"//g')";;
    *) pkg="$pkg $(echo $itm | sed 's/"//g')";;
  esac
done

instpkg "$pkg" "$aurpkg" || exit 1

exit 0
