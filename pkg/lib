baseurl=https://raw.githubusercontent.com/sevenzip2/archdi/master/pkg
cachedir=~/.cache/archdi


cat << EOF > dialog.archfi
use_shadow = OFF
title_color = (BLACK,WHITE,OFF)
button_label_active_color = (WHITE,BLUE,ON)
button_label_inactive_color = (BLACK,WHITE,OFF)
tag_color = (BLACK,WHITE,OFF)
tag_selected_color = (WHITE,BLUE,ON)
tag_key_color = (BLACK,WHITE,OFF)
tag_key_selected_color = (WHITE,BLUE,ON)
check_color = tag_color
check_selected_color = tag_selected_color
EOF
export DIALOGRC="dialog.archfi"


# $1: path
menu(){
  require $1 755 || return 1
  $cachedir/$1
  if [ $? = 0 ]; then
    menu $1
  fi
}


# $1: path
script(){
  require $1 755 || return 1
  $cachedir/$1
}


# echo the installed AUR helper (paru, yay or trizen)
getaurhelper(){
  for helper in paru yay trizen; do
    if [ -f /usr/bin/$helper ]; then
      echo $helper
      return 0
    fi
  done
  return 1
}


# AUR packages are built by the aurbuilder system account (makepkg refuses to run as root),
# in a private home. It gets passwordless pacman only while an AUR command runs (aurrun):
# pacman installs packages as root, so a permanent rule would be a permanent root access.
aurbuilderdir=/var/lib/aurbuilder

setupaurbuilder(){
  if [ ! -f /usr/bin/makepkg ]||[ ! -f /usr/bin/automake ]||[ ! -f /usr/bin/git ]; then
    pacman -S --needed --noconfirm base-devel git
  fi
  if ! id -u aurbuilder &>/dev/null; then
    useradd -r -N -d $aurbuilderdir -s /usr/bin/nologin aurbuilder
  fi
  # Older archdi versions used a world writable /tmp/aurbuilder home
  usermod -d $aurbuilderdir aurbuilder 2>/dev/null
  mkdir -p $aurbuilderdir
  chown aurbuilder: $aurbuilderdir
  chmod 700 $aurbuilderdir
  rm -f /etc/sudoers.d/aurbuilder
}

# $@ : command run as aurbuilder in its home, with sudo pacman allowed until it ends
aurrun(){
  setupaurbuilder
  writesudoers aurbuilder "aurbuilder ALL=(ALL) NOPASSWD: /usr/bin/pacman" || return 1
  trap 'rm -f /etc/sudoers.d/aurbuilder' EXIT INT TERM
  (cd $aurbuilderdir && sudo -u aurbuilder "$@")
  aurresult=$?
  rm -f /etc/sudoers.d/aurbuilder
  trap - EXIT INT TERM
  return $aurresult
}


# $1: pacman packages
# Many packages (ffmpeg...) need libjack.so, provided by jack2 or pipewire-jack which conflict.
# pacman picks jack2 by default and installing PipeWire later fails, so prefer pipewire-jack.
preferpipewirejack(){
  pkgs="$1"
  case " $pkgs " in
    *" jack2 "*|*" pipewire-jack "*|*" lib32-jack2 "*|*" lib32-pipewire-jack "*)
      echo "$pkgs"
      return
    ;;
  esac
  if ! pacman -Qq jack2 &>/dev/null && ! pacman -Qq pipewire-jack &>/dev/null; then
    resolved=$(pacman -Sp --print-format %n --needed --noconfirm $pkgs 2>/dev/null)
    if echo "$resolved" | grep -qx jack2; then
      pkgs="$pkgs pipewire-jack"
    fi
    if echo "$resolved" | grep -qx lib32-jack2 && ! pacman -Qq lib32-jack2 &>/dev/null; then
      pkgs="$pkgs lib32-pipewire-jack"
    fi
  fi
  echo "$pkgs"
}


# $1: pacman packages
# $2: aur packages
# Returns 1 when an installation failed or was cancelled, callers stop before configuring
instpkg(){
  instresult=0
  if [ ! "$1" = "" ]; then
    clear
    pkgs=$(preferpipewirejack "$1")
    if [ ! "$pkgs" = "$1" ]; then
      echo "libjack.so is needed : pipewire-jack is used instead of jack2"
    fi
    echo "# pacman -S --needed $pkgs"
    pacman -S --needed $pkgs || instresult=1
    pressanykey
  fi
  if [ ! "$2" = "" ]; then
    aurhelper=$(getaurhelper)
    if [ "$aurhelper" = "" ]; then
      echo "To install AUR packages, you need to install an aurhelper in updates menu !"
      pressanykey
      instresult=1
    else
      clear
      echo "# sudo -u aurbuilder $aurhelper -S --needed $2"
      aurrun $aurhelper -S --needed $2 || instresult=1
      pressanykey
    fi
  fi
  return $instresult
}


# $1: string
# $2: [title]
choosepkg(){
  if [ "$2" = "" ]; then
    title=$1
  else
    title=$2
  fi
  options=()
  items=$(pacman -Ssq $1)
  for item in $items; do
    options+=("$item" "" off)
  done
  sel=$(dialog --backtitle "$apptitle" --title "$title" --cancel-button "Back" --checklist "" 0 0 0 \
    "${options[@]}" \
    3>&1 1>&2 2>&3)
  if [ ! "$?" = "0" ]; then
    return 1
  fi
  for itm in $sel; do
    pkg="$pkg $(echo $itm | sed 's/"//g')"
  done
  instpkg "$pkg" "$aurpkg"
}


# $1: string
# $2: [title]
chooseaurpkg(){
  if [ "$2" = "" ]; then
    title=$1
  else
    title=$2
  fi
  options=()
  aurhelper=$(getaurhelper)
  if [ ! "$aurhelper" = "" ]; then
    # Searching needs no pacman rights, AUR helpers refuse to run as root
    setupaurbuilder
    items=$(cd $aurbuilderdir && sudo -u aurbuilder $aurhelper -Ssq $1)
  fi
  for item in $items; do
    options+=("$item" "" off)
  done
  sel=$(dialog --backtitle "$apptitle" --title "$title" --cancel-button "Back" --checklist "" 0 0 0 \
    "${options[@]}" \
    3>&1 1>&2 2>&3)
  if [ ! "$?" = "0" ]; then
    return 1
  fi
  for itm in $sel; do
    aurpkg="$aurpkg $(echo $itm | sed 's/"//g')"
  done
  instpkg "$pkg" "$aurpkg"
}


# $1: path
# $2: chmod
require(){
  if [ ! -f "$cachedir/$1" ]; then
    mkdir -p $cachedir/$(dirname $1) 2> /dev/null
    # -f: never save (and later run) an HTTP error page as a script
    if ! curl -fsSL "$baseurl/$1" -o "$cachedir/$1"; then
      rm -f "$cachedir/$1"
      echo "Unable to download $baseurl/$1"
      pressanykey
      cd $cachedir
      return 1
    fi
  fi
  chmod $2 $cachedir/$1
  cd $cachedir
}


# $1 : message
# $2 : args
confirm(){
  dialog --backtitle "$apptitle" $2 --yesno "$1" 0 0
}


pressanykey(){
  read -n1 -p "Press any key to continue."
}


# $1 : filename
editfile(){
  editor=$EDITOR
  if [ "$editor" == "" ]; then
    editor="nano"
  fi
  if [ ! -f "/usr/bin/$editor" ]; then
    editor="nano"
  fi
  echo "$editor $1"
  $editor "$1"
}


# True inside arch-chroot (archfi "Install and run archdi"), services can be enabled but not started
inchroot(){
  systemd-detect-virt -q --chroot
}


# Enable the [multilib] repository (32-bit packages : steam, wine, lib32-*)
# Returns 1 when multilib is not usable (refused, or the -Syu failed or was cancelled)
enablemultilib(){
  if grep -q '^\[multilib\]' /etc/pacman.conf&&[ -f /var/lib/pacman/sync/multilib.db ]; then
    return 0
  fi
  if (confirm "32-bit packages need the multilib repository.\n\nUncomment [multilib] in /etc/pacman.conf and run pacman -Syu ?") then
    clear
    sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /etc/pacman.conf
    echo "# pacman -Syu"
    pacman -Syu
    syncresult=$?
    if [ ! "$syncresult" = "0" ]; then
      echo ""
      echo "The system is not upgraded, 32-bit packages are not installed."
    fi
    pressanykey
    return $syncresult
  fi
  return 1
}


# $1 : user name
validusername(){
  [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]
}


# sudo (and visudo) is not part of the base install
requiresudo(){
  if [ ! -f /usr/bin/visudo ]; then
    echo "sudo is not installed : pacman -S --needed --noconfirm sudo"
    pacman -S --needed --noconfirm sudo
  fi
  if [ ! -f /usr/bin/visudo ]; then
    echo "sudo could not be installed, sudoers not changed"
    pressanykey
    return 1
  fi
}


# $1 : file name in /etc/sudoers.d
# $2 : content
# Validate with visudo before installing, a broken sudoers file locks sudo
writesudoers(){
  requiresudo || return 1
  tmpfile=$(mktemp)
  echo -e "$2" > $tmpfile
  if visudo -cqf $tmpfile; then
    install -m 0440 -o root -g root $tmpfile /etc/sudoers.d/$1
    rm -f $tmpfile
    return 0
  fi
  echo "Invalid sudoers content, /etc/sudoers.d/$1 not changed"
  rm -f $tmpfile
  pressanykey
  return 1
}


# $1 : sudoers file, edited with visudo (syntax check before save)
editsudoers(){
  requiresudo || return 1
  editor=$EDITOR
  if [ "$editor" == "" ]||[ ! -f "/usr/bin/$editor" ]; then
    editor="nano"
  fi
  echo "visudo -f $1"
  EDITOR=$editor visudo -f "$1"
}


# $1 : servicename
# $2 : [displayname]
svcstart(){
  if [ "$2" = "" ]; then
    displayname="$1"
  else
    displayname="$2 ($1)"
  fi
  if inchroot; then
    echo "$displayname will start at next boot (chroot)."
    return 0
  fi
  if (confirm "Start $displayname service ?\n\nsystemctl start $1") then
    clear
    echo "systemctl start $1"
    systemctl start $1
    pressanykey
  else
    exit 1
  fi
}

