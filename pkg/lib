# echo the headers of the installed kernels that are missing from $1
# DKMS builds its modules for every installed kernel, the headers are only optional dependencies of dkms
dkmsheaders(){
  for pkgbase in /usr/lib/modules/*/pkgbase; do
    if [ -f "$pkgbase" ]; then
      headers="$(cat "$pkgbase")-headers"
      if [[ " $1 " != *" $headers "* ]]&&pacman -Si $headers &>/dev/null; then
        echo -n " $headers"
      fi
    fi
  done
}

# $1 : desktop name (XDG_CURRENT_DESKTOP)
# $2 : name
# $3 : command
# xdg autostart entry for a program the default config of a compositor does not start, only in this desktop
autostartin(){
  file=/etc/xdg/autostart/archdi-$2-$1.desktop
  echo "$file :"
  echo "  Exec=$3"
  mkdir -p /etc/xdg/autostart
  cat << EOF > $file
[Desktop Entry]
Type=Application
Name=$2 ($1)
Exec=$3
OnlyShowIn=$1;
NoDisplay=true
EOF
}

# $1 : kernel package just installed (linux, linux-lts...)
# systemd-boot and Syslinux only boot the kernels they have an entry (or a UKI) for, GRUB needs a new grub.cfg
addkernelboot(){
  kernel=$1
  if [ ! -f /boot/vmlinuz-$kernel ]; then
    return 0
  fi
  if [ -f /boot/loader/loader.conf ]; then
    preset=/etc/mkinitcpio.d/$kernel.preset
    if grep -qs '^default_uki=' /etc/mkinitcpio.d/*.preset&&[ -f $preset ]&&! grep -q '^default_uki=' $preset; then
      # The other kernels use Unified Kernel Images, systemd-boot finds them in EFI/Linux
      echo "UKI for $kernel : $preset"
      sed -i -e "s|^#\?default_uki=.*|default_uki=\"/boot/EFI/Linux/arch-$kernel.efi\"|" \
        -e "s|^#\?fallback_uki=.*|fallback_uki=\"/boot/EFI/Linux/arch-$kernel-fallback.efi\"|" \
        -e "s|^default_image=|#default_image=|" \
        -e "s|^fallback_image=|#fallback_image=|" $preset
      echo "mkinitcpio -p $kernel"
      mkinitcpio -p $kernel
    elif [ ! -f /boot/loader/entries/arch-$kernel.conf ]&&[ -f /boot/initramfs-$kernel.img ]; then
      # Copy an existing entry (kernel options, microcode) and point it to the new kernel
      template=$(ls /boot/loader/entries/*.conf 2>/dev/null | grep -v fallback | head -n1)
      if [ "$template" = "" ]; then
        echo "No systemd-boot entry to copy, create one in Config > Boot > systemd-boot > Entries."
      else
        for variant in "" "-fallback"; do
          if [ -f /boot/initramfs-$kernel$variant.img ]; then
            echo "/boot/loader/entries/arch-$kernel$variant.conf"
            sed -e "s|^title .*|title   Arch Linux ($kernel$variant)|" \
              -e "s|/vmlinuz-[^ ]*|/vmlinuz-$kernel|" \
              -e "s|/initramfs-[^ ]*\.img|/initramfs-$kernel$variant.img|" \
              $template > /boot/loader/entries/arch-$kernel$variant.conf
          fi
        done
      fi
    fi
  fi
  cfg=/boot/syslinux/syslinux.cfg
  if [ -f $cfg ]&&! grep -Eq "vmlinuz-$kernel([ ,]|$)" $cfg; then
    # Copy the first kernel entry (APPEND options, microcode) and point it to the new kernel
    template=$(awk '/^LABEL /{ blk = ""; inblk = 1 }
      inblk { blk = blk $0 "\n" }
      inblk && /^[[:space:]]*$/ { if (blk ~ /vmlinuz-/ && blk !~ /fallback/) { printf "%s", blk; inblk = 0; exit } inblk = 0 }
      END { if (inblk && blk ~ /vmlinuz-/ && blk !~ /fallback/) printf "%s", blk }' $cfg | sed '/^[[:space:]]*$/d')
    if [ "$template" = "" ]; then
      echo "No Syslinux entry to copy, add $kernel to $cfg."
    else
      entries=""
      for variant in "" "-fallback"; do
        if [ -f /boot/initramfs-$kernel$variant.img ]; then
          entries="$entries$(echo "$template" | sed -e "s|^LABEL .*|LABEL arch-$kernel${variant#-}|" \
            -e "s|MENU LABEL .*|MENU LABEL Arch Linux ($kernel${variant:+, fallback})|" \
            -e "s|vmlinuz-[^ ,]*|vmlinuz-$kernel|" \
            -e "s|initramfs-[^ ,]*\.img|initramfs-$kernel$variant.img|")"$'\n\n'
        fi
      done
      echo "$cfg : arch-$kernel"
      # Before the tool entries (hdt, reboot, poweroff)
      awk -v entries="$entries" '!done && /^LABEL (hdt|reboot|poweroff)/ { printf "%s", entries; done = 1 }
        { print }
        END { if (!done) printf "\n%s", entries }' $cfg > $cfg.new && mv $cfg.new $cfg
    fi
  fi
  if [ -f /boot/grub/grub.cfg ]; then
    echo "grub-mkconfig -o /boot/grub/grub.cfg"
    grub-mkconfig -o /boot/grub/grub.cfg
  fi
}

# $1 : display manager service
# $2 : [displayname]
# Only one display-manager.service can be enabled, disable the current one first
dmenable(){
  current=$(readlink /etc/systemd/system/display-manager.service 2>/dev/null)
  current=${current##*/}
  if [ "$current" = "" ]; then
    # ly@ttyN.service is enabled from multi-user.target and has no display-manager alias
    current=$(ls /etc/systemd/system/multi-user.target.wants/ 2>/dev/null | grep -m1 '^ly@.*\.service$')
  fi
  if [ ! "$current" = "" ]&&[ ! "$current" = "$1.service" ]&&[ ! "$current" = "$1" ]; then
    # One question for the swap : never leave the system without a display manager
    if (confirm "$current is the current display manager.\n\nReplace it with $1 ?") then
      clear
      echo "systemctl disable $current"
      systemctl disable $current
      echo "systemctl enable $1"
      if ! systemctl enable $1; then
        echo "Unable to enable $1, $current is enabled again."
        systemctl enable $current
        pressanykey
        return 1
      fi
      # A Ly instance left next to another display manager would start too
      for ly in $(ls /etc/systemd/system/multi-user.target.wants/ 2>/dev/null | grep '^ly@.*\.service$'); do
        if [ ! "$ly" = "$1.service" ]&&[ ! "$ly" = "$1" ]; then
          echo "systemctl disable $ly"
          systemctl disable $ly
        fi
      done
      pressanykey
      return 0
    fi
    return 1
  fi
  svcenable $1 "$2"
}

# $1 : servicename
# $2 : [displayname]
svcdisable(){
  if [ "$2" = "" ]; then
    displayname="$1"
  else
    displayname="$2 ($1)"
  fi
  if (confirm "Disable $displayname service at boot ?\n\nsystemctl disable $1") then
    clear
    echo "systemctl disable $1"
    systemctl disable $1
    svcresult=$?
    pressanykey
    return $svcresult
  fi
  return 1
}



# Permanent rule left by older archdi versions
rm -f /etc/sudoers.d/aurbuilder 2>/dev/null

while (( "$#" )); do
  case $1 in
    --root)
      menu menu
      exit 0
    ;;
    --chroot)
      require menu 755
      sed -i "/options+=(\"Shutdown\" \"\")/d" menu
      menu menu
      exit 0
    ;;
  esac
  shift
done
