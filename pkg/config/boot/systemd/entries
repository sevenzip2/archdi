#!/bin/bash
. ./lib

options=()
options+=("Edit entry" "")
options+=("" "")
options+=("Update ucode" "")
options+=("" "")
options+=("Create entry" "")
options+=("Delete entry" "")

defaultitem="Edit entry"
sel=$(dialog --backtitle "$apptitle" --title "Systemd Entries Menu :" --default-item "$defaultitem" --cancel-button "Back" --menu "" 0 0 0 \
  "${options[@]}" \
  3>&1 1>&2 2>&3)
if [ ! "$?" = "0" ]; then
  exit 1
fi
sed -i "/^defaultitem=/c\defaultitem=\"$sel\"" $0

case $sel in
    'Edit entry')
      entries=$(ls /boot/loader/entries)
      entrylist=()
      for itm in $entries; do
        entrylist+=("${itm::-5}" "")
      done
      sel=$(dialog --backtitle "$apptitle" --title "Edit entry :" --cancel-button "Cancel" --menu "" 0 0 0 \
      "${entrylist[@]}" \
      3>&1 1>&2 2>&3)
      if [ "$?" = "0" ]; then
        editfile /boot/loader/entries/$sel.conf
      fi
    ;;
    'Create entry')
      entry=$(dialog --backtitle "$apptitle" --title "Create entry" --inputbox "Enter the new entry name :" 0 0 3>&1 1>&2 2>&3)
      if [ "$?" = "0" ]; then
        if [[ ! "$entry" =~ ^[A-Za-z0-9._-]+$ ]]; then
          dialog --backtitle "$apptitle" --title "Create entry" --msgbox "Invalid entry name : $entry" 0 0
          exit 0
        fi
        kernellist=()
        for itm in /boot/vmlinuz-*; do
          [ -f "$itm" ] && kernellist+=("${itm#/boot/vmlinuz-}" "")
        done
        kernel=$(dialog --backtitle "$apptitle" --title "Create entry : kernel" --cancel-button "Cancel" --menu "" 0 0 0 \
        "${kernellist[@]}" \
        3>&1 1>&2 2>&3)
        if [ "$?" = "0" ]; then
          # Start from the running kernel command line, without the loader specific parts
          cmdline=$(sed -E 's/(^| )(BOOT_IMAGE|initrd)=[^ ]*//g; s/^ +//' /proc/cmdline)
          printf "title   %s\nlinux   /vmlinuz-%s\ninitrd  /initramfs-%s.img\noptions %s\n" \
            "$entry" "$kernel" "$kernel" "$cmdline" > /boot/loader/entries/$entry.conf
          editfile /boot/loader/entries/$entry.conf
        fi
      fi
    ;;
    'Delete entry')
      entries=$(ls /boot/loader/entries)
      entrylist=()
      for itm in $entries; do
        entrylist+=("${itm::-5}" "")
      done
      sel=$(dialog --backtitle "$apptitle" --title "Delete entry :" --cancel-button "Cancel" --menu "" 0 0 0 \
      "${entrylist[@]}" \
      3>&1 1>&2 2>&3)
      if [ "$?" = "0" ]; then
        if (confirm "Delete $sel entry ?") then
          rm /boot/loader/entries/$sel.conf
        fi
      fi
    ;;
    'Update ucode')
      entries=$(ls /boot/loader/entries)
      entrylist=()
      for itm in $entries; do
        entrylist+=("${itm::-5}" "" on)
      done
      sel=$(dialog --backtitle "$apptitle" --title "Update ucode of :" --cancel-button "Cancel" --checklist "" 0 0 0 \
      "${entrylist[@]}" \
      3>&1 1>&2 2>&3)
      if [ "$?" = "0" ]; then
        endmsg="Nothing to do !"
        clear
        # With the mkinitcpio microcode hook, microcode is already embedded in the initramfs
        hooks=$(cat /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf 2>/dev/null | grep '^HOOKS=' | tail -n1)
        if [[ "$hooks" =~ [\(\ ]microcode[\)\ ] ]]; then
          for itm in $sel; do
            itm=${itm//\"/}
            if grep -qE '(amd|intel)-ucode.img' /boot/loader/entries/$itm.conf; then
              endmsg="Microcode is embedded by the mkinitcpio microcode hook."
              echo "Remove separate ucode initrd from $itm"
              sed -i -E "/(amd|intel)-ucode.img/d" /boot/loader/entries/$itm.conf
            fi
          done
          sel=""
          [ "$endmsg" = "Nothing to do !" ] && endmsg="Microcode is embedded by the mkinitcpio microcode hook, nothing to do !"
        fi
        for itm in $sel; do
          itm=${itm//\"/}
          if [ -f /boot/amd-ucode.img ]; then
            if [ ! "$(cat /boot/loader/entries/$itm.conf | grep amd-ucode.img)" ]; then
              endmsg=""
              echo "Add amd-ucode to $itm"
              sed -i "/vmlinuz/a initrd  /amd-ucode.img" /boot/loader/entries/$itm.conf
            fi
          else
            if [ "$(cat /boot/loader/entries/$itm.conf | grep amd-ucode.img)" ]; then
              endmsg=""
              echo "Remove amd-ucode from $itm"
              sed -i "/amd-ucode.img/d" /boot/loader/entries/$itm.conf
            fi
          fi
          if [ -f /boot/intel-ucode.img ]; then
            if [ ! "$(cat /boot/loader/entries/$itm.conf | grep intel-ucode.img)" ]; then
              endmsg=""
              echo "Add intel-ucode to $itm"
              sed -i "/vmlinuz/a initrd  /intel-ucode.img" /boot/loader/entries/$itm.conf
            fi
          else
            if [ "$(cat /boot/loader/entries/$itm.conf | grep intel-ucode.img)" ]; then
              endmsg=""
              echo "Remove intel-ucode from $itm"
              sed -i "/intel-ucode.img/d" /boot/loader/entries/$itm.conf
            fi
          fi
        done
        echo "$endmsg"
        pressanykey
      fi
    ;;
esac

exit 0
